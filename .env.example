# Docker Compose endpoint configuration. For the internal test server, retain
# these 192.168.1.88 values; change all four values together for another host.
BIND_ADDRESS=192.168.1.88
PUBLIC_KEYCLOAK_URL=http://192.168.1.88:8081
PUBLIC_MCP_URL=http://192.168.1.88:13000
GATEWAY_HOST_PORT=13000
RISK_CORE_HOST_PORT=18080
PROMETHEUS_HOST_PORT=19090

APP_RUNTIME_MODE=reference
REFERENCE_MODE=true
REFERENCE_AUTH=true
GATEWAY_PORT=3000
RISK_CORE_URL=http://localhost:8080
MCP_ALLOWED_HOSTS=192.168.1.88,localhost,127.0.0.1,ai-gateway
MCP_ALLOWED_ORIGINS=http://192.168.1.88:5173
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=120
OIDC_ISSUER=http://localhost:8081/realms/risk-aiops
MCP_AUDIENCE=risk-aiops-mcp
RISK_CORE_AUDIENCE=risk-core
GATEWAY_CLIENT_ID=ai-gateway
GATEWAY_CLIENT_SECRET=
MODEL_PROVIDER=fake
MARKET_DATA_SOURCE=reference
REQUIRE_SOURCE_MTLS=false
SERVER_SSL_CLIENT_AUTH=none
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
# Never commit real values. Compose reads secrets from an external secret store in non-reference environments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
