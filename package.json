{
  "name": "financial-trading-risk-aiops-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Institution-grade reference baseline for read-only financial trading risk diagnosis and operations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/ai-gateway",
    "apps/ops-console"
  ],
  "devDependencies": {
    "lodash-es": "4.18.1",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "scripts": {
    "dev:gateway": "npm run dev -w @risk-aiops/ai-gateway",
    "dev:console": "npm run dev -w @risk-aiops/ops-console",
    "build:node": "npm run build --workspaces --if-present",
    "build:java": "node scripts/mvn.mjs -B -DskipTests package",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:node": "npm run test --workspaces --if-present",
    "test:java": "node scripts/mvn.mjs -B test",
    "test:python": "cd apps/market-adapter && python -m pytest",
    "test": "npm run test:node && npm run test:java && npm run test:python",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:supply-chain": "node scripts/verify-image-lock.mjs && node scripts/verify-actions-lock.mjs",
    "eval": "node evals/run-evals.mjs",
    "check": "npm run typecheck && npm run test && npm run verify:contracts && npm run verify:supply-chain && npm run eval && npm run build:node && npm run build:java",
    "smoke": "npm run smoke -w @risk-aiops/ai-gateway",
    "compose:config": "docker compose -f compose.yaml config",
    "clean": "npm run clean --workspaces --if-present"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.1",
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  }
}
